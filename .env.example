# Copy to .env (never commit .env). No secrets are needed for the default (mock) setup.
# Provider: only "mock" works until a provider is admitted (see docs/adr/P00_DECISION_RECORD.md).
PW_PROVIDER=mock
# Dev/test PostgreSQL from `pnpm db:dev start` (user-owned cluster, no sudo, unix socket only).
# Use the exact URLs that command prints; the host= parameter is the socket directory, e.g.:
PW_TEST_DATABASE_URL=postgres://pw@localhost:54329/pw_test?host=/home/you/.local/share/paper-workspace/pg-dev/socket
PW_DATABASE_URL=postgres://pw@localhost:54329/pw_dev?host=/home/you/.local/share/paper-workspace/pg-dev/socket
# Headless browser for e2e when Playwright's own browser download is not wanted (optional)
# PW_CHROMIUM_PATH=/path/to/chrome

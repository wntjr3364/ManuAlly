# Copy to .env (never commit .env). No secrets are needed for the default (mock) setup.
# Provider: only "mock" works until a provider is admitted (see docs/adr/P00_DECISION_RECORD.md).
PW_PROVIDER=mock
# Dev/test PostgreSQL started by `pnpm db:dev` (user-owned cluster, no sudo, unix socket only).
# The test database name must start with pw_test.
PW_TEST_DATABASE_URL=postgres://pw@localhost:54329/pw_test
PW_DATABASE_URL=postgres://pw@localhost:54329/pw_dev

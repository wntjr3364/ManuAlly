{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-workspace:edit-proposal:v2",
  "title": "Server-normalized edit proposal v2 (RFC-005)",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "paper_id",
    "document_id",
    "base_revision_id",
    "outline_revision_id",
    "operation",
    "source_evidence_ids",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "proposal_id": {
      "type": "string",
      "format": "uuid"
    },
    "paper_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "base_revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "outline_revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "type": "object",
      "required": [
        "type",
        "selection_handle_id",
        "block_id",
        "expected_block_hash",
        "selected_slice_hash",
        "from",
        "to",
        "replacement"
      ],
      "properties": {
        "type": {
          "const": "replace_selection"
        },
        "selection_handle_id": {
          "type": "string",
          "format": "uuid"
        },
        "block_id": {
          "type": "string",
          "format": "uuid"
        },
        "expected_block_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selected_slice_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": "integer",
          "minimum": 0
        },
        "replacement": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "text"
                ],
                "properties": {
                  "type": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "marks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "bold",
                        "italic",
                        "subscript",
                        "superscript"
                      ]
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "reference_id"
                ],
                "properties": {
                  "type": {
                    "const": "citation"
                  },
                  "reference_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "locator": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "atom_index"
                ],
                "properties": {
                  "type": {
                    "const": "preserve_atom"
                  },
                  "atom_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "source_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "explanation": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Built by the server from a stored selection handle and the model's ai_replacement output. block_id/from/to/expected_block_hash/selected_slice_hash are copied from the handle, never from the model. from/to are editor-core ProseMirror positions (UTF-16 text, inline atom = 1). Semantic checks (from<to, grapheme boundaries, handle match, revision, authorization) are done by editor-core and the server, not by this schema."
}

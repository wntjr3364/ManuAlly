{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-workspace:provider-event:v1",
  "title": "Normalized provider event (PW-023)",
  "description": "What a provider adapter reports, in provider-independent form. A value the provider did not report is null (with the reason), never 0 or an invented time. Unknown raw events are kept as 'unrecognized' and not interpreted.",
  "type": "object",
  "required": ["schema_version", "provider", "kind", "data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "enum": ["mock", "claude_agent", "codex"] },
    "kind": { "enum": ["session_started", "text_delta", "message_completed", "tool_requested", "usage", "quota", "turn_completed", "compacted", "error", "unrecognized"] },
    "data": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "session_started" } } }, "then": { "properties": { "data": {
      "type": "object", "additionalProperties": false, "required": ["native_session_id", "tools", "model"],
      "properties": { "native_session_id": { "type": ["string", "null"] }, "tools": { "type": ["array", "null"], "items": { "type": "string" } }, "model": { "type": ["string", "null"] } } } } } },
    { "if": { "properties": { "kind": { "enum": ["text_delta", "message_completed"] } } }, "then": { "properties": { "data": {
      "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string" } } } } } },
    { "if": { "properties": { "kind": { "const": "tool_requested" } } }, "then": { "properties": { "data": {
      "type": "object", "additionalProperties": false, "required": ["tool", "call_id", "input"],
      "properties": { "tool": { "type": "string" }, "call_id": { "type": ["string", "null"] }, "input": {} } } } } },
    { "if": { "properties": { "kind": { "const": "usage" } } }, "then": { "properties": { "data": {
      "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "cost_usd_estimate", "context_window", "unknown_fields"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd_estimate": { "type": ["number", "null"], "minimum": 0 },
        "context_window": { "type": ["integer", "null"], "minimum": 1 },
        "unknown_fields": { "type": "array", "items": { "enum": ["input_tokens", "output_tokens", "cost_usd_estimate", "context_window"] } } } } } } },
    { "if": { "properties": { "kind": { "const": "quota" } } }, "then": { "properties": { "data": {
      "type": "object", "additionalProperties": false, "required": ["status", "used_percent", "resets_at", "raw_resets_at", "unknown_reason", "source"],
      "properties": {
        "status": { "enum": ["allowed", "warning", "rejected", "unknown"] },
        "used_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "resets_at": { "type": ["string", "null"], "format": "date-time" },
        "raw_resets_at": { "type": ["string", "null"], "maxLength": 100 },
        "unknown_reason": { "type": ["string", "null"] },
        "source": { "const": "official_adapter_event" } },
      "if": { "properties": { "resets_at": { "type": "null" } } }, "then": { "properties": { "unknown_reason": { "type": "string" } } } } } } },
    { "if": { "properties": { "kind": { "const": "turn_completed" } } }, "then": { "properties": { "data": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "stop_reason"],
      "properties": { "outcome": { "enum": ["success", "error", "interrupted", "unknown"] }, "stop_reason": { "type": ["string", "null"] } } } } } },
    { "if": { "properties": { "kind": { "const": "compacted" } } }, "then": { "properties": { "data": { "type": "object", "additionalProperties": false } } } },
    { "if": { "properties": { "kind": { "const": "error" } } }, "then": { "properties": { "data": {
      "type": "object", "additionalProperties": false, "required": ["kind", "message"],
      "properties": { "kind": { "enum": ["auth", "quota", "network", "provider", "unknown"] }, "message": { "type": "string", "maxLength": 2000 } } } } } },
    { "if": { "properties": { "kind": { "const": "unrecognized" } } }, "then": { "properties": { "data": {
      "type": "object", "additionalProperties": false, "required": ["raw_type"], "properties": { "raw_type": { "type": ["string", "null"], "maxLength": 200 } } } } } }
  ]
}
